{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/sol-5-6-cicd-lab/scenario.schema.json",
  "title": "Agent evaluation scenario",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "lane", "description", "expected"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "lane": { "enum": ["review", "implementation"] },
    "description": { "type": "string", "minLength": 1 },
    "expected": { "type": "object" }
  }
}
