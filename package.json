{
  "name": "sol-5-6-cicd-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Portable CI/CD and agent-evaluation lab for GPT-5.6 Sol coding and review workflows.",
  "scripts": {
    "check": "npm run ci",
    "validate": "node scripts/validate-contract.mjs && node scripts/validate-scenarios.mjs && node scripts/check-prompts.mjs",
    "test": "node --test",
    "ci": "node scripts/run-contract.mjs --mode required",
    "ci:advisory": "node scripts/run-contract.mjs --mode advisory",
    "scenario:list": "node scripts/scenarios.mjs list",
    "eval:review": "node scripts/run-pro-eval.mjs review",
    "eval:implementation": "node scripts/run-pro-eval.mjs implementation",
    "instructions:check": "node scripts/check-instructions.mjs",
    "instructions:install": "node scripts/install-codex-global.mjs",
    "eval:instructions": "node scripts/run-instruction-eval.mjs",
    "analyze:tool-failures": "node scripts/analyze-tool-failures.mjs",
    "probe:hooks": "node scripts/probe-codex-hooks.mjs",
    "guards:install": "node scripts/install-codex-guards.mjs",
    "guards:status": "node scripts/guards-status.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
