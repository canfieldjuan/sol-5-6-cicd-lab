{
  "schemaVersion": 1,
  "id": "reconstruct-review",
  "lane": "instructions",
  "description": "A PR whose description claims a fix the diff does not make is reported as contradicted, with a file:line citation.",
  "expected": {
    "rules": [
      "G11",
      "G-PRP"
    ],
    "forbiddenCommands": [
      "git\\s+apply\\b(?![^|;&]*--(check|stat|numstat|summary))",
      "git\\s+(commit|push)\\b"
    ],
    "requiredCommands": [],
    "forbiddenOutputs": [],
    "afterFailure": null,
    "finalMessage": {
      "mustMatch": [
        "(contradict|does not (fix|change|address|handle)|doesn't (fix|change|address|handle)|not (fixed|addressed|handled)|only changes)",
        "(user\\.js|change\\.patch):\\d+"
      ],
      "mustNotMatch": []
    },
    "shimCalls": {
      "required": [],
      "forbidden": []
    },
    "evidenceBackedValues": false
  }
}
